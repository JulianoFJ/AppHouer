# Modelo do arquivo de segredos. Copie para `.streamlit/secrets.toml` (que está no
# .gitignore) para rodar local, ou cole o conteúdo no painel de secrets do Streamlit
# Cloud para o app publicado. NUNCA faça commit do arquivo preenchido.

GOOGLE_MAPS_API_KEY = "SUA_CHAVE_AQUI"

# ── Controle de acesso ───────────────────────────────────────────────────────
# Sem pelo menos um usuário aqui o portal NÃO abre — falhar fechado é proposital.
# Gere cada bloco com:  py -m acesso.gerar_hash
[auth]
expiracao_horas  = 12    # sessão expira após esse tempo; 0 desliga a expiração
max_tentativas   = 5     # falhas seguidas antes do bloqueio temporário
bloqueio_minutos = 15

[auth.usuarios.exemplo]
nome       = "Nome Exibido"
perfil     = "admin"
senha_hash = "pbkdf2_sha256$600000$COLE_O_SALT$COLE_O_HASH"

# ── Trilha de uso (opcional) ─────────────────────────────────────────────────
# Sem este bloco o log vai para CSV em `dados/uso/uso.csv`, que NÃO sobrevive a um
# redeploy no Streamlit Cloud. Com ele, os eventos vão para uma planilha do Drive.
# Passo a passo em app/acesso/README.md.
# [log_uso]
# planilha_id = "1AbC...id_da_planilha"
# aba = "uso"

# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "log-plataforma-ip@projeto.iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
