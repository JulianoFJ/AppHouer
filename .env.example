# Modelo do arquivo de ambiente. Copie para `.env` (já coberto pelo .gitignore) para
# rodar `docker compose up`. NUNCA faça commit do arquivo preenchido.
#
# Estas mesmas variáveis são o que muda ao trocar de host: hoje apontam para o
# container `db` do Compose, amanhã podem apontar para uma instância RDS na AWS —
# o app e as migrations não sabem a diferença, só leem DATABASE_URL.

POSTGRES_USER=apphouer
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
POSTGRES_DB=apphouer

# Usada pelo app e pelo Alembic (via db.py). Precisa bater com as três variáveis acima
# e com o host/porta do serviço `db` do docker-compose.yml.
DATABASE_URL=postgresql://apphouer:TROQUE_ESTA_SENHA@db:5432/apphouer
